{
  "_comment": "All tunables live here. Nothing in src/ hard-codes a threshold.",
  "camera": {
    "index": -1,
    "scan_max_index": 7,
    "width": 1920,
    "height": 1080,
    "fps_request": 30,
    "buffer_size": 1,
    "flip_horizontal": false,
    "fourcc": "MJPG"
  },
  "model": {
    "weights": "yolo11m-pose.pt",
    "imgsz": 1280,
    "half": true,
    "device": "cuda:0",
    "person_conf": 0.3,
    "keypoint_conf": 0.3,
    "keypoint_conf_floor": 0.15,
    "min_person_height_px": 90,
    "max_det": 60,
    "tracker": "data/botsort_static.yaml",
    "max_consecutive_failures": 10,
    "warmup_sec": 3.0
  },
  "raise": {
    "_comment": "Graded score in [0,1]. Ramps are (value_at_0, value_at_1), normalized by torso length. A hand near the face must reach nose height; a hand held clear of the face (beside the head) counts from about chin height - beside_head_allowance sets how much lower.",
    "ramps": {
      "wrist_lift": [
        0.1,
        0.45
      ],
      "wrist_above_elbow": [
        -0.02,
        0.15
      ],
      "vertical_extension": [
        -0.1,
        0.05
      ],
      "elbow_lift": [
        -0.8,
        -0.3
      ],
      "arm_straightness": [
        50.0,
        110.0
      ],
      "forearm_vertical": [
        45.0,
        20.0
      ],
      "face_clearance": [
        0.12,
        0.25
      ]
    },
    "weights": {
      "wrist_lift": 0.25,
      "wrist_above_elbow": 0.1,
      "vertical_extension": 0.55,
      "elbow_lift": 0.1
    },
    "lateral_penalty_start": 0.9,
    "lateral_penalty_end": 1.6,
    "min_torso_px": 24.0,
    "straightness_floor": 0.3,
    "beside_head_allowance": 0.3
  },
  "temporal": {
    "_comment": "tau is a time constant in seconds, so filter behaviour is identical at any FPS.",
    "ema_tau_sec": 0.18,
    "enter_threshold": 0.55,
    "exit_threshold": 0.35,
    "hold_sec": 0.6,
    "track_grace_sec": 0.5,
    "track_expire_sec": 2.0,
    "require_fresh_raise": true,
    "fresh_lookback_sec": 1.5
  },
  "gating": {
    "require_single_hand": true,
    "one_credit_per_track": true,
    "seat_zone_lock": false,
    "seat_zone_tolerance_torso": 3.0
  },
  "session": {
    "reaction_delay_sec": 0.45,
    "response_window_sec": 6.0,
    "window_extension_sec": 1.5,
    "extend_if_score_above": 0.3,
    "result_hold_sec": 0.8,
    "stall_threshold_sec": 0.75,
    "max_speech_wait_sec": 8.0
  },
  "speech": {
    "_comment": "mode: full = whole registration number (S P two five, B C S, zero zero seven); short_unique = shortest unambiguous form (seven). engine: auto | sapi | pyttsx3.",
    "enabled": true,
    "engine": "auto",
    "mode": "full",
    "rate": 175,
    "volume": 1.0,
    "voice": "",
    "startup_announcement": "Attendance ready"
  },
  "output": {
    "dir": "",
    "save_evidence_images": true,
    "evidence_jpeg_quality": 88,
    "write_xlsx": true,
    "write_session_json": true,
    "evidence_min_width": 240
  }
}
